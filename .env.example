# The dashboard password. AI assistants connecting to MCP authenticate with a token
# derived from it: https://docs.jesse.trade/docs/mcp/setup#authentication
PASSWORD=test

APP_PORT=9000

# Optional: the address you use to open the dashboard from other machines, e.g. when Jesse
# runs on a home server or behind a reverse proxy. MCP is served at <DASHBOARD_URL>/mcp.
# Leave unset to use http://localhost:<APP_PORT>. Must be an origin without a path.
# DASHBOARD_URL=http://192.168.1.20:9000

# LSP (Python Language Server) WebSocket Port
LSP_PORT=9001

# If you want to see the MCP server logs in the terminal, set this to true, default is true (recommended)
MCP_LOG_IN_TERMINAL=true

# If not using docker, you probably want to set this to "localhost"
POSTGRES_HOST=postgres
# POSTGRES_HOST=localhost
POSTGRES_NAME=jesse_db
POSTGRES_PORT=5432
POSTGRES_USERNAME=jesse_user
POSTGRES_PASSWORD=password

# Set up an empty candle table when TimescaleDB is available (included in Docker).
# Plain PostgreSQL still works; populated candle tables require a manual migration.
# Set FALSE to keep an empty table in ordinary PostgreSQL storage.
TIMESCALEDB_ENABLED=TRUE

# Live Trade Only: (Below value doesn't concern you if you haven't installed the live trade plugin)
# Enter the API token which you created at https://jesse.trade/user/api-tokens:
LICENSE_API_TOKEN=
